# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── dependencies ────────────────────────────────────────────────────────────
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── testing ─────────────────────────────────────────────────────────────────
/coverage

# ── next.js ─────────────────────────────────────────────────────────────────
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# ── cloudflare / opennext build output ──────────────────────────────────────
.open-next/
.wrangler/
.dev.vars

# ── production ──────────────────────────────────────────────────────────────
/build

# ── misc ────────────────────────────────────────────────────────────────────
.DS_Store
*.pem

# ── debug logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log

# ── env files (never commit secrets) ────────────────────────────────────────
.env*

# ── vercel ──────────────────────────────────────────────────────────────────
.vercel

# ── editors / tooling ───────────────────────────────────────────────────────
.claude
.z-ai-config
.cursor
.idea
.vscode
local-*
prompt

# ── skills directory (workspace only) ───────────────────────────────────────
/skills/

# ─────────────────────────────────────────────────────────────────────────────
# Workspace-only files below — NOT part of the open-source repository.
